{
  "project-tracker-session": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./hooks/session_start.sh",
        "timeout": 15
      }
    ]
  },
  "project-tracker-portfolio": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/portfolio_regen.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "./hooks/reminders_sync_trigger.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
